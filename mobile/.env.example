# TaskFlow Mobile — конфигурация сервера

# Окружение: development | staging | production
ENVIRONMENT=production

# --- Основной адрес сервера (меняйте только здесь) ---
SERVER_HOST=YOUR_VPS_IP
API_PORT=3100

# Полные URL (необязательно). Если заданы — перекрывают SERVER_HOST + API_PORT
# API_BASE_URL=http://YOUR_VPS_IP:3100
# WEB_BASE_URL=http://YOUR_VPS_IP:3100

# Ссылки приглашений в группу (InviteScreen). По умолчанию = http://SERVER_HOST:API_PORT
# WEB_BASE_URL=http://YOUR_VPS_IP:3100

# Android App Links — хост без http:// (тот же IP или домен, где backend)
DEEP_LINK_HOST=YOUR_VPS_IP

# --- Локальная разработка на Android-эмуляторе ---
# true = backend на ПК, эмулятор ходит на 10.0.2.2
USE_ANDROID_EMULATOR_HOST=false
ANDROID_EMULATOR_HOST=10.0.2.2
ANDROID_EMULATOR_PORT=3100

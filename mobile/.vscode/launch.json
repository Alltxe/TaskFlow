{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "TaskFlow Mobile (Debug)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": [
                "--debug"
            ]
        },
        {
            "name": "TaskFlow Mobile (Chrome - Local Backend)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "chrome",
                "--web-port=8080",
                "--dart-define=API_BASE_URL=http://localhost:3000"
            ]
        },
        {
            "name": "TaskFlow Mobile (Chrome - Remote Backend)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "chrome",
                "--web-port=8080",
                "--dart-define=API_BASE_URL=https://your-backend-url.com"
            ]
        },
        {
            "name": "TaskFlow Mobile (Profile)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "flutterMode": "profile"
        },
        {
            "name": "TaskFlow Mobile (Release)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "flutterMode": "release"
        }
    ]
}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Universal Links (iOS App Links).
		Замените "taskflow.example.com" на реальный домен бэкенда.
		Домен должен отдавать /.well-known/apple-app-site-association.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:taskflow.example.com</string>
	</array>
</dict>
</plist>

# ============================================================
# TaskFlow backend — продакшен-демо (.env.production)
# Скопируйте в .env.production РЯДОМ с docker-compose.prod.yml на VPS
# и заполните значения. Файл с секретами в git НЕ коммитим.
#
# ВАЖНО: docker compose env_file НЕ раскрывает ${...} внутри значений —
# пишите значения целиком (например, DATABASE_URL уже собран из логина/пароля).
# ============================================================

# ---------- Образ backend (собран локально, загружен через docker load) ----------
BACKEND_IMAGE=taskflow-backend:latest

# ---------- Приложение ----------
NODE_ENV=production
PORT=3100

# ---------- PostgreSQL (уже развёрнут отдельно на VPS, порт 5432 на хосте) ----------
# host.docker.internal — шлюз к хосту из контейнера backend (см. extra_hosts в compose).
# USER/PASS/DB — те же, что в pgAdmin.
DATABASE_URL=postgresql://taskflow:CHANGE_ME_strong_db_password@host.docker.internal:5432/taskflow?schema=public

# ---------- JWT ----------
# Сгенерируйте: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_run_openssl_rand_base64_48
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ---------- CORS ----------
# Для мобильного клиента CORS почти не важен. Можно указать IP/домен через запятую.
CORS_ORIGIN=http://localhost

# ---------- MinIO (объектное хранилище) ----------
# Внутри docker-сети backend ходит на сервис 'minio:9000'.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_BUCKET=taskflow
# ВНЕШНИЙ адрес, по которому устройства будут СКАЧИВАТЬ файлы.
# Замените на публичный IP вашего VPS!
MINIO_PUBLIC_URL=http://YOUR_VPS_IP:9000

# ---------- Health-check пороги (подняты под слабый VPS) ----------
HEALTH_MEMORY_HEAP_MB=300
HEALTH_MEMORY_RSS_MB=500
HEALTH_DISK_PATH=/
HEALTH_DISK_THRESHOLD_PERCENT=0.9

# ---------- Повторяющиеся задачи (НЕ каждую минуту в проде!) ----------
RECURRING_CRON_SCHEDULE=0 * * * *

# ---------- Уведомления ----------
NOTIFICATION_LOCALE=ru

# ---------- SMTP (email-верификация, сброс пароля). Можно оставить пустым для демо. ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TaskFlow <noreply@taskflow.app>
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15

# ---------- Firebase Cloud Messaging (push). Без них push просто отключится. ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Приватный ключ одной строкой с \n вместо переносов.
FIREBASE_PRIVATE_KEY=

# ---------- Deep links (App Links / Universal Links) ----------
ANDROID_PACKAGE_NAME=com.taskflow.app
ANDROID_SHA256_FINGERPRINT=AA:BB:CC:...release_keystore_fingerprint
IOS_TEAM_ID=XXXXXXXXXX
IOS_BUNDLE_ID=com.taskflow.app
